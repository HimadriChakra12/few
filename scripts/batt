#!/usr/bin/env bash

while true; do
    # Read battery percentage (works on most Linux systems)
    BATTERY=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1)

    # Optional: Read charging status
    STATUS=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n1)

    doi -i "🔋" "Battery: ${BATTERY}% (${STATUS})"

    # Sleep for 30 minutes
    sleep 1800
done
